#!/bin/bash
# Wrapper for GitHub Copilot CLI with session selection support
# Install: sudo mv /usr/local/bin/copilot /usr/local/bin/copilot-real
#          sudo cp copilot-sessions /usr/local/bin/
#          sudo ln -s /path/to/copilot-wrapper /usr/local/bin/copilot
#
# Usage: copilot [options]
#   --select, -S             Interactive session selection (requires fzf)
#   --keyword, -K word       Search and select sessions by keyword
#   --list, -L               List all sessions (no selection)
#   --list -k word           List sessions filtered by keyword
#   All other options passed to copilot

COPILOT_REAL="/usr/local/bin/copilot-real"
COPILOT_SESSIONS="/usr/local/bin/copilot-sessions"
SESSION_DIR="$HOME/.copilot/session-state"

# Parse arguments
SELECT_MODE=false
LIST_MODE=false
KEYWORD=""
ARGS=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --select|-S) SELECT_MODE=true; shift ;;
        --keyword|-K) KEYWORD="$2"; SELECT_MODE=true; shift 2 ;;
        --list|-L) LIST_MODE=true; shift ;;
        -k) KEYWORD="$2"; shift 2 ;;
        *) ARGS+=("$1"); shift ;;
    esac
done

if $LIST_MODE; then
    if [[ -n "$KEYWORD" ]]; then
        exec "$COPILOT_SESSIONS" -k "$KEYWORD"
    else
        exec "$COPILOT_SESSIONS"
    fi
elif $SELECT_MODE; then
    if ! command -v fzf &>/dev/null; then
        echo "fzf is required for session selection. Install with: sudo dnf install fzf" >&2
        exit 1
    fi

    if [[ -n "$KEYWORD" ]]; then
        short_id=$("$COPILOT_SESSIONS" -k "$KEYWORD" -s)
    else
        short_id=$("$COPILOT_SESSIONS" -s)
    fi

    if [[ -n "$short_id" ]]; then
        # Find full session ID from short prefix
        for entry in "$SESSION_DIR"/*; do
            full_id=$(basename "$entry" .jsonl)
            if [[ "$full_id" == "$short_id"* ]]; then
                exec "$COPILOT_REAL" --resume="$full_id" "${ARGS[@]}"
            fi
        done
        echo "Session not found: $short_id" >&2
        exit 1
    else
        # User cancelled - start new session
        exec "$COPILOT_REAL" "${ARGS[@]}"
    fi
else
    exec "$COPILOT_REAL" "${ARGS[@]}"
fi
